# انسخ هذا الملف باسم .env وحط المفتاح بداله. ملف .env ما ينرفع لـ GitHub.
# المزوّد الأساسي حسب الخطة: Claude Sonnet 4.6
MASAR_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MASAR_MODEL=claude-sonnet-4-6

# بديل مجاني للمقارنة (اختياري): groq أو gemini
# MASAR_PROVIDER=groq
# GROQ_API_KEY=
# MASAR_MODEL=openai/gpt-oss-120b
# MASAR_PROVIDER=gemini
# GEMINI_API_KEY=
# MASAR_MODEL=gemini-3-flash-lite

# حد الثقة: أقل منه تروح الشكوى للمراجعة. يتضبط على مجموعة الضبط (calib) فقط.
MASAR_CONFIDENCE_THRESHOLD=0.75

# موديل توليد بيانات المسابقة (scripts/generate_llm_dataset.py). الافتراضي نفس موديل النظام.
# MASAR_GEN_PROVIDER=anthropic
# MASAR_GEN_MODEL=claude-sonnet-4-6

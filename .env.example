# انسخ هذا الملف باسم .env وحط المفتاح. ملف .env ما ينرفع لـ GitHub.

# المزوّد الافتراضي: Groq (الخطة المجانية)
MASAR_PROVIDER=groq
MASAR_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# مستوى تفكير gpt-oss: low | medium | high (الأعلى يصرف من الحد اليومي أكثر)
MASAR_REASONING_EFFORT=low
# عدد الشكاوى اللي تتعالج سوية. 1 مناسب للخطة المجانية.
MASAR_WORKERS=1

# حد الثقة: أقل منه تروح الشكوى للمراجعة. يتضبط على مجموعة الضبط (calib) فقط.
MASAR_CONFIDENCE_THRESHOLD=0.75

# موديل توليد البيانات (scripts/generate_llm_dataset.py). الافتراضي نفس موديل النظام.
# MASAR_GEN_PROVIDER=groq
# MASAR_GEN_MODEL=openai/gpt-oss-120b

# بديل مدفوع (غير مفعّل): Anthropic
# MASAR_PROVIDER=anthropic
# MASAR_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=
